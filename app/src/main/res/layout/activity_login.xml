<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0e14"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XREG"
        android:textColor="#a855f7"
        android:textSize="40sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IM PROXY EDITION"
        android:textColor="#6b7785"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="48dp"
        android:letterSpacing="0.15"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141122"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LICENSE KEY"
            android:textColor="#6b7785"
            android:textSize="10sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/keyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="••••-••••"
            android:textColorHint="#3a2f5c"
            android:textColor="#ffffff"
            android:backgroundTint="#2a2145"
            android:padding="14dp"
            android:inputType="text"
            android:gravity="center"
            android:letterSpacing="0.2"/>

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="AUTHENTICATE"
            android:textColor="#fff"
            android:textStyle="bold"
            android:backgroundTint="#7c3aed"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="12sp"
        android:letterSpacing="0.1"/>
</LinearLayout>
